# Copia este archivo a .env y completa los valores. NO subas .env al repositorio.

# URL publica (ngrok cuenta #1) hacia Ollama en SageMaker
OLLAMA_URL=https://REEMPLAZAR.ngrok-free.app
OLLAMA_MODEL=REEMPLAZAR_nombre:tag

# URL publica (ngrok cuenta #2) hacia el servicio de imagen en Colab
IMAGE_API_URL=https://REEMPLAZAR.ngrok-free.app

# Authtokens de ngrok (solo en el entorno donde corre cada tunel)
NGROK_AUTHTOKEN_OLLAMA=
NGROK_AUTHTOKEN_IMAGE=
