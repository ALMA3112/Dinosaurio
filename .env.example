# Copia este archivo a .env y completa los valores. NO subas .env al repositorio.

# URL publica (ngrok cuenta #1) hacia Ollama en SageMaker  (bash ollama_setup/03_exponer_ngrok.sh)
OLLAMA_URL=https://REEMPLAZAR.ngrok-free.app
OLLAMA_MODEL=mistral:7b
# Opcional: un modelo mas pequeno solo para el chat (mas rapido). Hay que descargarlo antes en SageMaker:
#   sudo docker exec ollama ollama pull qwen2.5:3b
# OLLAMA_CHAT_MODEL=qwen2.5:3b

# URL publica (ngrok cuenta #2) hacia la API de imagenes en Colab (la imprime el notebook image_gen/01_imagen_colab.ipynb)
IMAGE_API_URL=https://REEMPLAZAR.ngrok-free.app
# Para nombres nuevos: 768 y 22 pasos (~15 s). Mas calidad pero mas lento: IMAGE_SIZE=1024 e IMAGE_STEPS=30 (~40 s)
IMAGE_SIZE=768
IMAGE_STEPS=22

# Los authtokens de ngrok NO van aqui: se pegan en el momento (script de SageMaker) o en los Secretos de Colab.
